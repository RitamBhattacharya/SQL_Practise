6) Write a PL/SQL program to fill up the table sphere(rad number(2),area number(10,2), volume 
 number(15,2)) with radius values from 1 - 20
===============================================================================================
DECLARE
	RAD NUMBER;
	AREA NUMBER;
	VOLUME NUMBER;
	PI NUMBER := 3.14;
BEGIN
	FOR RAD IN 1..20 LOOP
		AREA:=PI*RAD*RAD;
		VOLUME:=4/3 * PI * RAD * RAD * RAD;
		INSERT INTO SPHERE VALUES(RAD,AREA,VOLUME); 
	END LOOP;
END;




