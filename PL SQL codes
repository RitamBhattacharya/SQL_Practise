24)FIBONACCI SERIES FOR N NUMBER OF TERMS
==========================================
DECLARE
	N NUMBER;
	A NUMBER :=0;
	B NUMBER :=1;
	C NUMBER;
	CO NUMBER := 1;
BEGIN
	N:=&N;
	DBMS_OUTPUT.PUT_LINE(A);
	DBMS_OUTPUT.PUT_LINE(B);
	 LOOP
		C:=A+B;
		EXIT WHEN CO+2>N;        --AS A AND B ARE ALREADY PRINTED SO  WE HAVE TO EXIT WHEN CO+2>N 
		DBMS_OUTPUT.PUT_LINE(C);
		A:=B;
		B:=C; 
		CO:=CO+1;
	END LOOP;
END;
/



