19)Armstrong Number:
======================
DECLARE
	N NUMBER;
	LEN NUMBER;
	R NUMBER;
	S NUMBER:=0;
	N1 NUMBER;
BEGIN
	N:=&N;
	N1:=N;
	LEN:=LENGTH(N);
	WHILE N > 0 LOOP
		R:=N MOD 10;
		S:=S+POWER(R,LEN);
		N:=FLOOR(N/10);
	END LOOP;

	IF S=N1 THEN
		DBMS_OUTPUT.PUT_LINE(N1|| ' IS ARMSTRONG');
	ELSE
		DBMS_OUTPUT.PUT_LINE(N1|| ' IS NOT ARMSTRONG');
	END IF;
END;
/


